PORT=6000
NODE_ENV=development
DATABASE_NAME=your_database_name
DATABASE_PASSWORD=your_database_password
DATABASE_USERNAME=your_database_username
DATABASE_PORT=5432
DATABASE_HOST=your_database_host
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Booking payment deadlines (minutes from booking creation, per plan).
# Unpaid PENDING bookings expire and release their seats after this window.
# Defaults: DAILY=60, WEEKLY=360, MONTHLY=1440, QUARTERLY=2880, YEARLY=4320.
#BOOKING_PAYMENT_TTL_DAILY_MINUTES=60
#BOOKING_PAYMENT_TTL_WEEKLY_MINUTES=360
#BOOKING_PAYMENT_TTL_MONTHLY_MINUTES=1440
#BOOKING_PAYMENT_TTL_QUARTERLY_MINUTES=2880
#BOOKING_PAYMENT_TTL_YEARLY_MINUTES=4320

# ConvertKit API Configuration
CONVERTKIT_API_KEY=your_convertkit_api_key_here
CONVERTKIT_FORM_ID=your_convertkit_form_id_here

# Cloudinary Configuration (required for profile pictures)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=profile-pictures

# Email Configuration
# Production SMTP Settings (Gmail, SendGrid, AWS SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# Mailtrap (Development/Testing Only)
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=your_mailtrap_user
MAILTRAP_PASS=your_mailtrap_pass

# Company Information
COMPANY_NAME=NovaLabs
SUPPORT_EMAIL=support@yourdomain.com
FRONTEND_URL=http://localhost:3000

# Redis Configuration (for Bull Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Prometheus metrics scrape token (GET /api/metrics).
# Generate with: openssl rand -base64 48
# Configure the Prometheus job with bearer_token / bearer_token_file.
# Alias: METRICS_TOKEN. If unset, only an admin JWT can read metrics.
# If this and JWT_SECRET are both unset, the endpoint fails closed (401).
METRICS_SCRAPE_TOKEN=

# Email Rate Limiting
EMAIL_RATE_LIMIT_PER_HOUR=100

# Email Provider Webhook Secrets (Optional)
SENDGRID_WEBHOOK_SECRET=your_sendgrid_webhook_secret
MAILGUN_WEBHOOK_SECRET=your_mailgun_webhook_secret
SES_SNS_TOPIC_ARN=your_ses_sns_topic_arn

# Audit Log – Security IP Retention
# Number of days raw (unmasked) IPs are kept in security_ip_log before the
# nightly purge job removes them.  Defaults to 30 if not set.
SECURITY_IP_RETENTION_DAYS=30

# Secrets Provider Configuration
# Choose the secrets backend: env | doppler | vault | aws (default: env)
SECRETS_PROVIDER=env

# Doppler Secrets Provider (requires SECRETS_PROVIDER=doppler)
DOPPLER_TOKEN=
DOPPLER_SERVICE_TOKEN=
DOPPLER_CACHE_TTL_MS=300000

# Vault Secrets Provider (requires SECRETS_PROVIDER=vault)
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_PATH=secret/data/nova-labs
VAULT_NAMESPACE=
VAULT_CACHE_TTL_MS=300000

# AWS Secrets Manager (requires SECRETS_PROVIDER=aws)
AWS_REGION=us-east-1
AWS_SECRETS_MANAGER_ARN=
AWS_SECRETS_CACHE_TTL_MS=300000

# ── Soroban / Stellar on-chain escrow (issue #227) ──────────────────
# Escrow is enabled when ANY of these is set; then ALL are required and
# validated at boot. If all four are unset the escrow path stays
# disabled and long-term bookings confirm without on-chain records.
# 64-char hex contract ID of the deployed payment_escrow contract
STELLAR_ESCROW_CONTRACT_ID=
# Stellar account (G…) that receives released escrow funds
STELLAR_BENEFICIARY_ADDRESS=
# Network alias (TESTNET | PUBLIC | FUTURENET) or full network passphrase
STELLAR_NETWORK=TESTNET
# Secret key (S…) of the platform account that signs escrow transactions
STELLAR_SECRET_KEY=
